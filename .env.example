NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_or_anon_key

# Server-only — used by app/api/intelligence routes to invoke the research-lead
# Edge Function and write to lead_intelligence with elevated privileges.
# Get it from Supabase dashboard -> Settings -> API -> service_role key.
# NEVER prefix this with NEXT_PUBLIC_ — it must stay server-side only.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Which scraping provider app/api/enrich/{start,run-pending} invoke:
# 'firecrawl' (enrich-leads, default) or 'apify' (start-enrichment +
# apify-webhook-handler). APIFY_API_TOKEN / APIFY_WEBHOOK_SECRET /
# FIRECRAWL_API_KEY / OPENAI_API_KEY are Edge Function secrets, not Next.js
# env vars — set them with `supabase secrets set`, not here.
ENRICHMENT_PROVIDER=firecrawl

# Where the lead-magnet report's "Book a call" button points (Calendly/Cal.com
# etc). Public — safe to expose. Falls back to "#" if unset.
NEXT_PUBLIC_BOOKING_URL=https://cal.com/your-handle/15min

# --- Lead-magnet report Edge Function secrets (generate-report) ---
# Set these with `supabase secrets set`, NOT here — they are Edge Function
# secrets, same as APIFY_API_TOKEN / OPENAI_API_KEY / FIRECRAWL_API_KEY above:
#   TALLY_WEBHOOK_SECRET  — shared secret; Tally webhook URL must include
#                           ?secret=<this value> so the function can auth it.
#   PAGESPEED_API_KEY     — optional; PageSpeed Insights works keyless at a
#                           lower quota, a key just raises the rate limit.
#   RESEND_API_KEY        — emails the finished report link to the prospect.
#   REPORT_FROM_EMAIL     — the From, e.g. "U-Flow <reports@yourdomain.com>";
#                           must be a Resend-verified sender/domain.
#   REPORT_BASE_URL       — deployed app origin (no trailing slash); the emailed
#                           link is <REPORT_BASE_URL>/report/<id>.
